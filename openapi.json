{
  "openapi": "3.1.0",
  "info": {
    "title": "Lughet API",
    "version": "0.1.0",
    "description": "Read-only original draft Uyghur starter lexicon. Code is MIT; original data is CC0-1.0. GitHub Pages hosts the offline demo; HTTP endpoints require the supplied server or a function deployment. GET routes accept HEAD; OPTIONS supports public CORS.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "Local server; replace with your actual HTTP API deployment."
    }
  ],
  "paths": {
    "/v1/search": {
      "get": {
        "operationId": "search",
        "summary": "Search words, Latin hints and English definitions",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Empty or omitted queries return an empty list.",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success with dataset provenance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Entry"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/suggest": {
      "get": {
        "operationId": "suggest",
        "summary": "Autocomplete a Uyghur or Latin prefix",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Empty or omitted queries return an empty list.",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 8
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success with dataset provenance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "word",
                          "latin"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "word": {
                            "type": "string"
                          },
                          "latin": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/words/{id}": {
      "get": {
        "operationId": "getWord",
        "summary": "Get an entry and its provenance",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,60}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success with dataset provenance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Entry"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/word-of-the-day": {
      "get": {
        "operationId": "wordOfTheDay",
        "summary": "Get a deterministic word for the current UTC date",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success with dataset provenance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Entry"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Service and dataset status",
        "responses": {
          "200": {
            "description": "Service health.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "const": "lughet"
                    },
                    "version": {
                      "type": "string"
                    },
                    "datasetVersion": {
                      "type": "string"
                    },
                    "totalEntries": {
                      "type": "integer"
                    },
                    "reviewStatus": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "A structured error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Entry": {
        "type": "object",
        "required": [
          "id",
          "word",
          "latin",
          "partOfSpeech",
          "definition",
          "audioUrl",
          "reviewStatus",
          "sourceIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,60}$"
          },
          "word": {
            "type": "string"
          },
          "latin": {
            "type": "string",
            "description": "Latin lookup hint, not a normative transliteration standard."
          },
          "partOfSpeech": {
            "type": "string"
          },
          "definition": {
            "type": "string",
            "description": "English editorial draft definition."
          },
          "audioUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "No audio is supplied in the starter dataset."
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "draft",
              "reviewed"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Source": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "license",
          "kind",
          "attribution"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "datasetVersion",
          "reviewStatus",
          "totalEntries",
          "sources"
        ],
        "properties": {
          "datasetVersion": {
            "type": "string"
          },
          "reviewStatus": {
            "type": "string"
          },
          "totalEntries": {
            "type": "integer"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "query": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string",
            "const": "UTC"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
