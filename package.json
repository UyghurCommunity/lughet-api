{
  "name": "@uyghurcommunity/lughet",
  "version": "0.1.0",
  "description": "A dependency-free Uyghur lexicon SDK with a local dataset adapter and HTTP API.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" },
    "./data": { "types": "./src/dataset.d.ts", "import": "./src/dataset.js" },
    "./package.json": "./package.json"
  },
  "files": ["src", "data/lexicon.json", "LICENSE", "LICENSE-DATA", "README.md"],
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "generate:data": "node scripts/generate-data.mjs",
    "prepack": "node scripts/generate-data.mjs && node --test"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "author": "UyghurCommunity",
  "repository": { "type": "git", "url": "https://github.com/UyghurCommunity/lughet-api.git" },
  "homepage": "https://uyghurcommunity.github.io/lughet-api/",
  "keywords": ["uyghur", "dictionary", "lexicon", "sdk", "rtl", "lughet"],
  "publishConfig": { "access": "public" }
}
